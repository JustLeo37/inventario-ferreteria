    {
      "key": "token_vendedor",
      "value": ""
    },
    {
      "key": "categoria_id",
      "value": ""
    },
    {
      "key": "producto_id",
      "value": ""
    },
    {
      "key": "producto_temp_id",
      "value": ""
    },
    {
      "key": "stock_antes",
      "value": ""
    }
  ],
  "item": [
